[
  {
    "id": "maximum-port-rejected",
    "kind": "regression",
    "file": "src/config.ts",
    "before": "Number(value) > 65535",
    "after": "Number(value) >= 65535",
    "detects": [
      "rejects out-of-range ports and values that could insert extra directives"
    ]
  },
  {
    "id": "invalid-port-accepted",
    "kind": "regression",
    "file": "src/config.ts",
    "before": "Number(value) < 1",
    "after": "Number(value) < 0",
    "detects": [
      "rejects out-of-range ports and values that could insert extra directives"
    ]
  },
  {
    "id": "case-insensitive-collision-lost",
    "kind": "regression",
    "file": "src/config.ts",
    "before": "name.toLowerCase() === alias.toLowerCase()",
    "after": "name === alias",
    "detects": [
      "rejects collisions and ambiguous targets rather than choosing a block"
    ]
  },
  {
    "id": "host-after-defaults",
    "kind": "regression",
    "file": "src/config.ts",
    "before": "lines.splice(defaults.start, 0, block + newline);",
    "after": "lines.push(block + newline);",
    "detects": [
      "adds a host before wildcard defaults so its options take precedence"
    ]
  },
  {
    "id": "inline-comment-lost",
    "kind": "regression",
    "file": "src/config.ts",
    "before": "const suffix = rows[index].comment ? ` ${rows[index].comment}` : \"\";",
    "after": "const suffix = \"\";",
    "detects": [
      "updates equals syntax and retains inline comments and CRLF endings"
    ]
  },
  {
    "id": "identity-quotes-retained",
    "kind": "regression",
    "file": "src/config.ts",
    "before": "= unquote(row.value);",
    "after": "= row.value;",
    "detects": [
      "lists local aliases without treating defaults or Match sections as hosts"
    ]
  },
  {
    "id": "property-construction-reordered",
    "kind": "refactor",
    "file": "src/config.ts",
    "before": "return [entry];",
    "after": "const { alias, ...options } = entry;\n    return [{ ...options, alias }];",
    "detects": [
      "lists local aliases without treating defaults or Match sections as hosts"
    ]
  },
  {
    "id": "port-error-reworded",
    "kind": "refactor",
    "file": "src/config.ts",
    "before": "Port must be an integer from 1 to 65535.",
    "after": "Choose a whole-number port between 1 and 65535.",
    "detects": [
      "rejects out-of-range ports and values that could insert extra directives"
    ]
  }
]
